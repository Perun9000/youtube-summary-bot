#!/usr/bin/env python3
"""Перечитать динамический Outline-ключ Paper VPN и обновить конфиг sslocal.

Paper ротирует серверы (2026-07-24: 163.5.229.70 -> 103.104.246.129), поэтому
конфиг нельзя прибивать гвоздями. --restart перезапускает прокси при смене.
"""
import base64, json, os, subprocess, sys, urllib.parse, urllib.request

URL = open("/etc/papervpn-key.url").read().strip()
raw = urllib.request.urlopen(URL, timeout=20).read().decode().strip()
u = urllib.parse.urlsplit(raw)
userinfo, _, hostport = u.netloc.rpartition("@")
host, _, port = hostport.rpartition(":")
pad = userinfo + "=" * (-len(userinfo) % 4)
method, _, password = base64.urlsafe_b64decode(pad).decode().partition(":")
cfg = {
    "server": host, "server_port": int(port),
    "method": method, "password": password,
    "local_address": "172.17.0.1", "local_port": 8118, "protocol": "http",
}
path = "/etc/papervpn-sslocal.json"
try:
    old = json.load(open(path))
except Exception:
    old = None
if old == cfg:
    print("unchanged")
    sys.exit(0)
json.dump(cfg, open(path, "w"))
os.chmod(path, 0o600)
print("updated ->", host, port)
if "--restart" in sys.argv:
    subprocess.run(["systemctl", "restart", "papervpn-proxy"], check=False)
